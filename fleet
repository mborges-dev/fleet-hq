# ── Dispatch ─────────────────────────────────────────────────────────────────
[[ $# -eq 0 ]] && { cmd_status; exit 0; }
cmd="$1"; shift
case "$cmd" in
  status|s)              cmd_status "$@" ;;
  new|start)             cmd_new "$@" ;;
  tell|send)             cmd_tell "$@" ;;
  watch|attach)          cmd_watch "$@" ;;
  log|history)           cmd_log "$@" ;;
  kill|stop)             cmd_kill "$@" ;;
  list|ls)               cmd_list "$@" ;;
  pending|inbox)         cmd_pending "$@" ;;
  dnd)                   cmd_dnd "$@" ;;
  dashboard|dash|ui|hq)  cmd_dashboard "$@" ;;
  tokens|usage|cost)     cmd_tokens "$@" ;;
  notify)                cmd_notify "$@" ;;
  say)                   cmd_say "$@" ;;
  chat)                  cmd_chat "$@" ;;
  schedule)              cmd_schedule "$@" ;;
  unschedule)            cmd_unschedule "$@" ;;
  schedules)             cmd_schedules "$@" ;;
  scheduler)             cmd_scheduler "$@" ;;
  watcher)               "$SCRIPTS/watcher.sh" "$@" ;;
  memory|mem)            "$SCRIPTS/memory.sh" "$@" ;;
  world|worlds)          cmd_world "$@" ;;
  assign)                cmd_assign "$@" ;;
  events)                cmd_events "$@" ;;
  earn|earned)           cmd_earn "$@" ;;
  revenue|earnings)      cmd_revenue "$@" ;;
  ask)                   cmd_ask "$@" ;;
  asks)                  cmd_asks "$@" ;;
  answer|reply)          cmd_answer "$@" ;;
  dismiss)               cmd_dismiss "$@" ;;
  venture|ventures)      cmd_venture "$@" ;;
  goal)                  cmd_goal "$@" ;;
  propose)               cmd_propose "$@" ;;
  approve)               cmd_approve "$@" ;;
  reject)                cmd_reject "$@" ;;
  proposals)             cmd_proposals "$@" ;;
  spawn)                 cmd_spawn "$@" ;;
  templates)             cmd_templates "$@" ;;
  help|-h|--help)        cmd_help ;;
  *)
    echo "${RED}Unknown command: $cmd${RESET}" >&2; echo >&2
    cmd_help >&2; exit 1 ;;
esac
